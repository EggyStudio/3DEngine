<Project Sdk="Microsoft.NET.Sdk">

    <!-- The flat API over every area, the package a game references, which carries every area's
         assembly in its lib folder beside its own. The projects of the areas lie in the folders
         below this one, each with its own project file, so this one compiles the API's folder
         alone. -->
    <PropertyGroup>
        <AssemblyName>3DEngine</AssemblyName>
        <EnableDefaultItems>false</EnableDefaultItems>
        <PackageId>3DEngine</PackageId>
        <IsPackable>true</IsPackable>
        <Title>3DEngine</Title>
        <Description>A C# game engine in which a program opens a window, draws each frame with plain static calls named as raylib's functions are, and draws Dear ImGui in the same frame, over SDL3, Vulkan and Slang, with an ECS and source-generated behaviors underneath.</Description>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Api\**\*.cs" />
    </ItemGroup>

    <!-- What the package carries beside the library, the generator as an analyzer so a game's
         [Behavior] and [Command] code is generated, and the shaders. -->
    <ItemGroup>
        <None Include="..\3DEngine.Generator\bin\$(Configuration)\netstandard2.0\3DEngine.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <!-- Its diagnostics' fixes, which an editor loads beside it. -->
        <None Include="..\3DEngine.CodeFixes\bin\$(Configuration)\netstandard2.0\3DEngine.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <!-- The shaders compiled ahead by build/pack.sh, so a game loads them with no slangc. -->
        <Content Include="..\build\shader-cache\*.spv;..\build\shader-cache\*.uniforms" Visible="false" CopyToOutputDirectory="Never" Pack="true" PackagePath="contentFiles/any/any/source/.slang-cache/" PackageCopyToOutput="true" BuildAction="None" />
    </ItemGroup>

    <!-- Built-in shaders are staged under source/ beside every program that references the
         engine, which is where AssetServer's file reader is rooted. Content items flow to
         referencing projects, so the examples and the tests receive them without a rule of
         their own. -->
    <ItemGroup>
        <Content Include="Shaders\**\*">
            <TargetPath>source\shaders\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <!-- In the package, as content files a consuming project copies to the same place.
                 Pack puts a file under its own folder below this one, as tonemapping/'s tables,
                 so the path names no folder of its own. -->
            <Pack>true</Pack>
            <PackagePath>contentFiles/any/any/source/shaders/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
            <BuildAction>None</BuildAction>
        </Content>
    </ItemGroup>

    <!-- Every area's project. The package carries each one's assembly and documentation, and none
         of them is a dependency of the package. NuGet writes a dependency for each project
         reference the restore does not hold private, so while packing, which dotnet pack marks with
         _IsPacking for its restore and its pack alike, every reference is private, and otherwise
         each project of the repository referencing this one sees every area through it. -->
    <ItemDefinitionGroup Condition="'$(_IsPacking)' == 'true'">
        <ProjectReference>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemDefinitionGroup>
    <ItemGroup>
        <ProjectReference Include="Core\3DEngine.Core.csproj" />
        <ProjectReference Include="Diagnostics\3DEngine.Diagnostics.csproj" />
        <ProjectReference Include="Graphics\3DEngine.Graphics.csproj" />
        <ProjectReference Include="Platform\3DEngine.Platform.csproj" />
        <ProjectReference Include="Assets\3DEngine.Assets.csproj" />
        <ProjectReference Include="Cli\3DEngine.CliServer.csproj" />
        <ProjectReference Include="Platform\Audio\3DEngine.Audio.csproj" />
        <ProjectReference Include="Rendering\3DEngine.Rendering.csproj" />
        <ProjectReference Include="GlobalIllumination\3DEngine.GlobalIllumination.csproj" />
        <ProjectReference Include="Physics\3DEngine.Physics.csproj" />
        <ProjectReference Include="Scenes\3DEngine.Scenes.csproj" />
        <ProjectReference Include="Modeling\3DEngine.Modeling.csproj" />
        <ProjectReference Include="Gui\3DEngine.Gui.csproj" />
        <!-- The Sky module's types, which the day sky names, a repository of its own under modules/
             and no package, whose assembly the package carries beside the areas'. -->
        <ProjectReference Include="..\modules\Sky\Sky\Sky.csproj" PrivateAssets="all" />
    </ItemGroup>

    <!-- The packages from outside that the areas build on, named again here, since a package
         depends on what its own project names and the areas are not packages. NormTests' N 2.8
         holds each to the version its areas name. -->
    <ItemGroup>
        <PackageReference Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" />
        <PackageReference Include="SDL3-CS.Native" Version="3.5.0-preview.20260205-174353" />
        <PackageReference Include="Vortice.Vulkan" Version="3.3.0" />
        <PackageReference Include="Twizzle.ImGui-Bundle.NET" Version="1.91.5.2" />
        <PackageReference Include="StbImageSharp" Version="2.30.16" />
        <PackageReference Include="AssimpNetter" Version="6.0.5" />
        <PackageReference Include="NVorbis" Version="0.10.5" />
        <PackageReference Include="NLayer" Version="3.0.0" />
        <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
        <PackageReference Include="BepuUtilities" Version="2.5.0-beta.29" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    </ItemGroup>

    <!-- Each project reference's assembly and documentation, the areas' and the Sky module's, in
         the package's lib folder beside this project's, from the paths the references resolved
         to, and each one's symbols in the symbols package beside this project's. build/pack.sh
         packs with the build, so the references resolve as the build resolves them. The generator
         is referenced as an analyzer alone and the package carries it in its analyzers folder. -->
    <PropertyGroup>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);E3DCarryProjects</TargetsForTfmSpecificBuildOutput>
        <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);E3DCarryProjectSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
    </PropertyGroup>
    <Target Name="E3DCarryProjects" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <_E3DCarried Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
            <BuildOutputInPackage Include="@(_E3DCarried)" />
            <BuildOutputInPackage Include="@(_E3DCarried->'%(RootDir)%(Directory)%(Filename).xml')"
                                  Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')" />
        </ItemGroup>
    </Target>
    <Target Name="E3DCarryProjectSymbols" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <_E3DCarriedReferences Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
            <_E3DCarriedSymbols Include="@(_E3DCarriedReferences->'%(RootDir)%(Directory)%(Filename).pdb')" />
            <TfmSpecificDebugSymbolsFile Include="@(_E3DCarriedSymbols)" Condition="Exists('%(FullPath)')">
                <TargetFramework>$(TargetFramework)</TargetFramework>
                <TargetPath>%(Filename)%(Extension)</TargetPath>
            </TfmSpecificDebugSymbolsFile>
        </ItemGroup>
    </Target>

</Project>
