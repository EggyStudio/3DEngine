<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>3DEngine</AssemblyName>
        <RootNamespace>Engine</RootNamespace>
        <!-- The behavior, scene and command generators are compiled into the engine as well as into the
             analyzer, so RuntimeBehaviorCompiler can run them through CSharpGeneratorDriver on
             scripts compiled while an app runs. RS1041, RS1036 and RS2008 apply only to the analyzer hosting model. -->
        <NoWarn>$(NoWarn);RS1041;RS1036;RS2008</NoWarn>
        <!-- A fault in the XML documentation stops the build where it is written, rather than
             reaching CI as an annotation: malformed or misplaced comments, a param or typeparam
             for nothing, one missing beside the others, and a cref or paramref that names
             nothing or more than one thing. -->
        <!-- And a public member with no documentation at all is an error here, though Directory.Build.props
             silences it for the tests, examples and tools, since a game's editor shows the summary of
             everything public in this project. -->
        <NoWarn>$(NoWarn.Replace(';CS1591', ''))</NoWarn>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS0419;CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1592;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735</WarningsAsErrors>

        <PackageId>3DEngine</PackageId>
        <Version>0.1.0-preview.1</Version>
        <Title>3DEngine</Title>
        <Description>A C# game engine used the way raylib is: open a window, draw each frame with plain static calls, and draw Dear ImGui in the same frame, over SDL3, Vulkan and Slang, with an ECS and source-generated behaviors underneath.</Description>
        <PackageTags>game-engine;raylib;vulkan;sdl3;imgui;slang;ecs;3d;2d</PackageTags>
        <PackageProjectUrl>https://github.com/EggyStudio/3DEngine</PackageProjectUrl>
        <!-- build/pack.sh writes the commits since the version was last raised to a file it names. -->
        <PackageReleaseNotes Condition="'$(ReleaseNotesFile)' != '' And Exists('$(ReleaseNotesFile)')">$([System.IO.File]::ReadAllText('$(ReleaseNotesFile)'))</PackageReleaseNotes>
    </PropertyGroup>

    <!-- What the package carries beside the library: its icon and readme, the generator as an
         analyzer so a game's [Behavior] and [Command] code is generated, and the shaders. -->
    <ItemGroup>
        <None Include="..\.github\assets\logo.png" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\3DEngine.Generator\bin\$(Configuration)\netstandard2.0\3DEngine.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <!-- Its diagnostics' fixes, which an editor loads beside it. -->
        <None Include="..\3DEngine.CodeFixes\bin\$(Configuration)\netstandard2.0\3DEngine.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <!-- The shaders compiled ahead by build/pack.sh, so a game loads them with no slangc. -->
        <Content Include="..\build\shader-cache\*.spv;..\build\shader-cache\*.uniforms" Visible="false" CopyToOutputDirectory="Never" Pack="true" PackagePath="contentFiles/any/any/source/.slang-cache/" PackageCopyToOutput="true" BuildAction="None" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\3DEngine.Generator\Behaviors\**\*.cs" Link="Behaviors\Generator\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\3DEngine.Generator\Scenes\**\*.cs" Link="Scenes\Generator\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\3DEngine.Generator\Commands\**\*.cs" Link="Diagnostics\Generator\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Built-in shaders are staged under source/ beside every program that references the
         engine, which is where AssetServer's file reader is rooted. Content items flow to
         referencing projects, so the examples and the tests receive them without a rule of
         their own. -->
    <ItemGroup>
        <Content Include="Shaders\**\*">
            <TargetPath>source\shaders\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <!-- In the package, as content files a consuming project copies to the same place. -->
            <Pack>true</Pack>
            <PackagePath>contentFiles/any/any/source/shaders/%(RecursiveDir)</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
            <BuildAction>None</BuildAction>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Engine.Tests" />
        <InternalsVisibleTo Include="e3d" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AssimpNetter" Version="6.0.4" />
        <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
        <PackageReference Include="BepuUtilities" Version="2.5.0-beta.29" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <PackageReference Include="NLayer" Version="3.0.0" />
        <PackageReference Include="NVorbis" Version="0.10.5" />
        <PackageReference Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" />
        <PackageReference Include="SDL3-CS.Native" Version="3.5.0-preview.20260205-174353" />
        <PackageReference Include="StbImageSharp" Version="2.30.15" />
        <PackageReference Include="Twizzle.ImGui-Bundle.NET" Version="1.91.5.2" />
        <PackageReference Include="Vortice.Vulkan" Version="3.2.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\3DEngine.Generator\3DEngine.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

</Project>
