<Project Sdk="Microsoft.NET.Sdk">

    <!-- The flat API over every area, the package a game references, which brings the areas'
         packages with it. The projects of the areas lie in the folders below this one, each with
         its own project file, so this one compiles the API's folder alone. -->
    <PropertyGroup>
        <AssemblyName>3DEngine</AssemblyName>
        <EnableDefaultItems>false</EnableDefaultItems>
        <PackageId>3DEngine</PackageId>
        <Title>3DEngine</Title>
        <Description>A C# game engine in which a program opens a window, draws each frame with plain static calls named as raylib's functions are, and draws Dear ImGui in the same frame, over SDL3, Vulkan and Slang, with an ECS and source-generated behaviors underneath.</Description>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Api\**\*.cs" />
    </ItemGroup>

    <!-- What the package carries beside the library, the generator as an analyzer so a game's
         [Behavior] and [Command] code is generated, and the shaders. -->
    <ItemGroup>
        <None Include="..\3DEngine.Generator\bin\$(Configuration)\netstandard2.0\3DEngine.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <!-- Its diagnostics' fixes, which an editor loads beside it. -->
        <None Include="..\3DEngine.CodeFixes\bin\$(Configuration)\netstandard2.0\3DEngine.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <!-- The shaders compiled ahead by build/pack.sh, so a game loads them with no slangc. -->
        <Content Include="..\build\shader-cache\*.spv;..\build\shader-cache\*.uniforms" Visible="false" CopyToOutputDirectory="Never" Pack="true" PackagePath="contentFiles/any/any/source/.slang-cache/" PackageCopyToOutput="true" BuildAction="None" />
    </ItemGroup>

    <!-- Built-in shaders are staged under source/ beside every program that references the
         engine, which is where AssetServer's file reader is rooted. Content items flow to
         referencing projects, so the examples and the tests receive them without a rule of
         their own. -->
    <ItemGroup>
        <Content Include="Shaders\**\*">
            <TargetPath>source\shaders\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <!-- In the package, as content files a consuming project copies to the same place.
                 Pack puts a file under its own folder below this one, as tonemapping/'s tables,
                 so the path names no folder of its own. -->
            <Pack>true</Pack>
            <PackagePath>contentFiles/any/any/source/shaders/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
            <BuildAction>None</BuildAction>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="Core\3DEngine.Core.csproj" />
        <ProjectReference Include="Diagnostics\3DEngine.Diagnostics.csproj" />
        <ProjectReference Include="Graphics\3DEngine.Graphics.csproj" />
        <ProjectReference Include="Platform\3DEngine.Platform.csproj" />
        <ProjectReference Include="Assets\3DEngine.Assets.csproj" />
        <ProjectReference Include="Cli\3DEngine.CliServer.csproj" />
        <ProjectReference Include="Platform\Audio\3DEngine.Audio.csproj" />
        <ProjectReference Include="Rendering\3DEngine.Rendering.csproj" />
        <ProjectReference Include="Physics\3DEngine.Physics.csproj" />
        <ProjectReference Include="Scenes\3DEngine.Scenes.csproj" />
        <ProjectReference Include="Modeling\3DEngine.Modeling.csproj" />
        <ProjectReference Include="Gui\3DEngine.Gui.csproj" />
        <!-- The Sky module's types, which the day sky names, carried by the renderer's package. -->
        <ProjectReference Include="..\modules\Sky\Sky\Sky.csproj" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" />
        <PackageReference Include="Twizzle.ImGui-Bundle.NET" Version="1.91.5.2" />
        <PackageReference Include="StbImageSharp" Version="2.30.15" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    </ItemGroup>

</Project>
