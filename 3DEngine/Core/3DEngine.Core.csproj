<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>3DEngine.Core</AssemblyName>
        <PackageId>3DEngine.Core</PackageId>
        <Title>3DEngine.Core</Title>
        <Description>The app, the world's resources, the schedule and its stages, plugins, events, input, time and logging, with the ECS and the behaviors, which every other project of the engine stands on.</Description>
    </PropertyGroup>

    <!-- The ECS and the behaviors are folders of their own beside this one, and the behavior, scene
         and command generators are compiled in as well as run as the analyzer, so
         RuntimeBehaviorCompiler can run them through CSharpGeneratorDriver on scripts compiled
         while an app runs. RS1041, RS1036 and RS2008 apply only to the analyzer hosting model. -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);RS1041;RS1036;RS2008</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\Ecs\**\*.cs" Link="Ecs\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\Behaviors\**\*.cs" Link="Behaviors\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\..\3DEngine.Generator\Behaviors\**\*.cs" Link="Behaviors\Generator\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\..\3DEngine.Generator\Scenes\**\*.cs" Link="Scenes\Generator\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\..\3DEngine.Generator\Commands\**\*.cs" Link="Diagnostics\Generator\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <PackageReference Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" />
    </ItemGroup>

</Project>
