<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>3DEngine.GlobalIllumination</AssemblyName>
        <PackageId>3DEngine.GlobalIllumination</PackageId>
        <Title>3DEngine.GlobalIllumination</Title>
