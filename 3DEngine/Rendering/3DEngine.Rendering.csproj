<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>3DEngine.Rendering</AssemblyName>
        <PackageId>3DEngine.Rendering</PackageId>
        <Title>3DEngine.Rendering</Title>
        <Description>The renderer, its render graph, passes, lighting, global illumination and scene field, and each area's part of the device.</Description>
    </PropertyGroup>

    <!-- The Sky module, a repository of its own under modules/ and no package, whose assembly and
         documentation the engine's package carries beside the areas'. -->
    <ItemGroup>
        <ProjectReference Include="..\..\modules\Sky\Sky\Sky.csproj" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\3DEngine.Core.csproj" />
        <ProjectReference Include="..\Diagnostics\3DEngine.Diagnostics.csproj" />
        <ProjectReference Include="..\Graphics\3DEngine.Graphics.csproj" />
        <ProjectReference Include="..\Platform\3DEngine.Platform.csproj" />
        <ProjectReference Include="..\Assets\3DEngine.Assets.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Vortice.Vulkan" Version="3.3.0" />
        <PackageReference Include="StbImageSharp" Version="2.30.16" />
        <PackageReference Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" />
    </ItemGroup>

</Project>
