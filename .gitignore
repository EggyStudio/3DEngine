# .NET build output
# Unanchored on purpose: every project directory has its own pair.
bin/
obj/

# NuGet
/packages/
*.nupkg
*.snupkg
# A local nuget.config usually carries machine-specific feed paths.
NuGet.config.user

# Tests, coverage and build logs
TestResults/
*.trx
*.coverage
coverage*.xml
coverage*.json
BenchmarkDotNet.Artifacts/
*.binlog
msbuild.log

# Everything the build scripts generate, including the Slang compiler that
# build/fetch-slang.sh downloads into build/tools.
/build/tools/
/build/artifacts/
/build/package/
# The templates as build/pack.sh packs them, with the version written in.
/build/templates/
/build/shader-cache/
# Mesa's cache of the shaders lavapipe compiles, which CI names here and keeps from run to run.
/build/mesa-cache/
# An NVIDIA driver's cache of the pipelines the suite compiles, which build/test.py names here.
/build/nvidia-cache/
# What an app launched by `e3d open` writes, so its output can be read after it is gone.
/build/sessions/
# Claude Code's own folder, its lock file and state the tool's, kept out of the tree.
.claude/
# What CI and build/play-game.sh capture and log, kept as a run's artifact.
/captures/

# Compiled Slang, written beside the assets of whatever ran a shader. Every checkout fetches
# slangc and fills this again, so a copy in git would go stale with every shader edit. A game
# that ships without a compiler carries its cache in its own build output.
.slang-cache/

# IDEs
# JetBrains (Rider)
.idea/
*.DotSettings.user
*.iml
_ReSharper.Caches/
_ReSharper.*/

# Visual Studio
.vs/
*.user
*.suo
*.userprefs

# Visual Studio Code
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Local-only
.ref/

# Dear ImGui's own window layout file, written beside whatever ran it.
imgui.ini
/build/soak/

# The raylib build/examples-table.py and build/raylib-bench/run.sh read, cloned at its pinned commit.
/build/raylib-bench/work/
# raylib's own resources, which build/fetch-raylib-resources.sh downloads for the examples.
/3DEngine.Examples/raylib-resources/
