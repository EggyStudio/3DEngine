<Project Sdk="Microsoft.NET.Sdk">

    <!-- A program outside the solution, built against the engine's package the way a game is. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- The newest the folder has, since build/pack.sh stamps each pack with its time. -->
        <PackageReference Include="3DEngine" Version="0.1.0-*" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="resources\**\*" CopyToOutputDirectory="PreserveNewest" />
        <!-- The models the examples and Tumble carry, taken from where they are rather than copied. -->
        <Content Include="..\..\3DEngine.Examples\resources\arm.gltf;..\..\3DEngine.Examples\resources\morph.gltf;..\..\3DEngine.Examples\resources\torus.obj;..\..\3DEngine.Examples\resources\torus.mtl;..\..\3DEngine.Examples\resources\checker.png;..\Tumble\resources\robot.glb;..\Tumble\resources\robot-CC0.txt"
                 Link="resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\..\3DEngine.Examples\resources\shaders\toon.slang;..\..\3DEngine.Examples\resources\shaders\life.slang;..\..\3DEngine.Examples\resources\shaders\plasma.slang;..\..\3DEngine.Examples\resources\shaders\grayscale.slang"
                 Link="resources\shaders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
