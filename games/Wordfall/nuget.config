<?xml version="1.0" encoding="utf-8"?>
<!-- The engine's package as build/pack.sh makes it, beside nuget.org for its dependencies. -->
<configuration>
  <packageSources>
    <add key="engine" value="../../build/package" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- nuget.org has a package of the same name that is someone else's, so the engine's name is
       sent only to the folder. -->
  <packageSourceMapping>
    <packageSource key="engine">
      <package pattern="3DEngine" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
