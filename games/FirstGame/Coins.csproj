<Project Sdk="Microsoft.NET.Sdk">

    <!-- The game docs/first-game.md builds a step at a time, from the engine's package as a
         program of the reader's own is. Program.cs is the last step, and steps/ holds every step
         whole, which build/first-game.sh builds one after another. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- The newest the folder has, since build/pack.sh stamps each pack with its time. -->
        <PackageReference Include="3DEngine" Version="0.1.0-*" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="steps\**" />
        <Content Include="resources\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
