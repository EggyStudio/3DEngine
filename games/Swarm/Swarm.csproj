<Project Sdk="Microsoft.NET.Sdk">

    <!-- A game outside the solution, built against the engine's package the way a user's is. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- The newest the folder has, since build/pack.sh stamps each pack with its time. -->
        <PackageReference Include="3DEngine" Version="0.1.0-*" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="resources\**\*" CopyToOutputDirectory="PreserveNewest" />
        <!-- The scripts are compiled by the running game, not with it, so they are copied beside
             it and left out of its own compile, where they would be registered twice. -->
        <Compile Remove="source\**" />
        <Content Include="source\**\*.cs" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
