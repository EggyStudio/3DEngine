<?xml version="1.0" encoding="utf-8"?>
<!-- The engine's package as build/pack.sh makes it, beside nuget.org for its dependencies. -->
<configuration>
  <packageSources>
    <add key="engine" value="../../build/package" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
