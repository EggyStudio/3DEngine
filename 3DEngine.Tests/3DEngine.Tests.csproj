<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The engine grants InternalsVisibleTo("Engine.Tests"), so the test assembly carries
             that name. -->
        <AssemblyName>Engine.Tests</AssemblyName>
        <RootNamespace>Engine.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\3DEngine\3DEngine.csproj" />
    </ItemGroup>

    <!-- The generators' code fixes, compiled in as the engine compiles the generators, with the
         workspace layer they apply edits through at the engine's compiler version. -->
    <ItemGroup>
        <Compile Include="..\3DEngine.CodeFixes\**\*.cs" Exclude="..\3DEngine.CodeFixes\obj\**;..\3DEngine.CodeFixes\bin\**" Link="CodeFixes\%(RecursiveDir)%(Filename)%(Extension)" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" Version="7.2.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0-pre.4">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- Named by folder rather than as **\*.ogg, because an explicit glob skips the default
             excludes and would pick up the copy in bin and nest it one level deeper each build. -->
        <None Include="Platform\Audio\*.ogg" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Platform\Audio\*.mp3" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Platform\Audio\*.flac" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Platform\Audio\*.wav" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Platform\Audio\*.xm" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Platform\Audio\*.mod" CopyToOutputDirectory="PreserveNewest" />
        <!-- The skinned arm the examples animate, which the animation tests pose. -->
        <None Include="..\3DEngine.Examples\resources\arm.gltf" Link="resources\arm.gltf" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\games\Summit\resources\hero.gltf" Link="resources\hero.gltf" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\3DEngine.Examples\resources\morph.gltf" Link="resources\morph.gltf" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Api\layered-morph.gltf" CopyToOutputDirectory="PreserveNewest" />
        <!-- Four glyphs, three past U+FFFF, which build/make-test-font.py writes. -->
        <None Include="Api\planes.ttf" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Api\bitmaps.ttf" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Api\layers.ttf" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Api\paints.ttf" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Api\layers.ttc" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Api\sbix.ttf" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Api\raylib-shapes.txt" CopyToOutputDirectory="PreserveNewest" />
        <!-- Summit's level, its prefabs and their models, which a reference frame of the game loads. -->
        <None Include="..\games\Summit\resources\level.json" Link="resources\level.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\games\Summit\resources\prefabs\*.json" Link="resources\prefabs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\games\Summit\resources\models\*" Link="resources\models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
