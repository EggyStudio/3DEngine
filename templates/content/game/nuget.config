<?xml version="1.0" encoding="utf-8"?>
<!-- The engine from a folder of packages built from a checkout, and everything else from nuget.org. -->
<configuration>
  <packageSources>
    <add key="engine" value="PACKAGE_FOLDER" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="engine">
      <package pattern="3DEngine" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
