<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- A program on the package gets every area's package through the engine's, and the
             projects' references reach this one the same way through the engine's project. -->
        <DisableTransitiveProjectReferences>false</DisableTransitiveProjectReferences>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <RootNamespace>Engine.Examples</RootNamespace>
    </PropertyGroup>

    <!-- Files the examples load, found beside the program as resources/<name>. -->
    <ItemGroup>
        <Content Include="resources\**\*" CopyToOutputDirectory="PreserveNewest" />
        <!-- Summit's hero, which the layered clips example plays, kept once in the game's art. -->
        <Content Include="..\games\Summit\resources\hero.gltf" Link="resources\hero.gltf" CopyToOutputDirectory="PreserveNewest" />
        <!-- raylib's own, fetched by build/fetch-raylib-resources.sh, at the paths its examples load. -->
        <Content Include="raylib-resources\**\*" Link="resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\3DEngine\3DEngine.csproj" />
        <!-- The Sky module, whose types the engine's API takes, as a package carries it beside the engine. -->
        <ProjectReference Include="..\modules\Sky\Sky\Sky.csproj" />
        <ProjectReference Include="..\3DEngine.Generator\3DEngine.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
